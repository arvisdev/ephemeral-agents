# M3 §2 per-run env — copied to vm-xb at /opt/poc/secrets/m3.env (chmod 600)
# NEVER in git or images (M3 §5 verifies). Values without a marker are safe defaults.
LLM_WIKI_REPO_URL=https://github.com/arvisdev/llm-wiki
# LLM_WIKI_READ_TOKEN=   # fine-grained PAT, contents:read on arvisdev/llm-wiki only — optional (clone degrades)
# GITHUB_READ_TOKEN=     # App installation token injected by lifecycle at spawn — do NOT hardcode
# ANTHROPIC_BASE_URL=     # router endpoint — provider-interchangeable: omniroute, openrouter, abacus, or any anthropic-compatible router (owner will swap freely; never assume omniroute)
# ANTHROPIC_API_KEY=     # router API key injected by lifecycle at spawn — do NOT hardcode
# MODEL_API_KEY=         # injected by lifecycle at spawn — do NOT hardcode
# GITHUB_APP_ID=         # owner supplies (M3 §1c)
# INSTALLATION_ID=       # owner supplies (M3 §1c)
