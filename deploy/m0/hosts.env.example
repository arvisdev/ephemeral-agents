# POC host map — copy to hosts.env (gitignored) and fill in:
#   cp hosts.env.example hosts.env
# All six install scripts auto-load deploy/m0/hosts.env when present.
# Values are ssh ALIASES (from ~/.ssh/config) — not IPs, except NETPLAN_*.

# --- required ---------------------------------------------------------------
# Proxmox host (the scripts qm-create + start VMs here, as root-on-host via ssh)
PVE_HOST=pve
# The three POC VMs (ssh as user 'poc').
# Legend (POC hostnames -> diagram discussion labels, D-8 resolved 2026-10-25):
#   VM_XA=vm-xa          -> VM-Xa (manager template VM)
#   VM_XB=vm-xb          -> VM-Xb (ephemeral agent VM: queue + orchestrator + containers)
#   VM_3=vm-hindsight    -> VM-3  (Hindsight: long-term memory, R/W)
# The labels are discussion devices, not a commitment: rename freely for your
# own estate; only the ROLE each VM plays is load-bearing.
VM_XA=vm-xa
VM_XB=vm-xb
VM_3=vm-hindsight

# Static IPs each VM must come up with (the M0 gate checks these)
NETPLAN_IP_XA=192.0.2.11
NETPLAN_IP_XB=192.0.2.12
NETPLAN_IP_3=192.0.2.14

# --- worked example ----------------------------------------------------------
# Say the PVE LAN pool hands your estate the 198.51.100.0/24 range (example addresses only — RFC 5737 documentation range). Pick three free
# addresses and use THE SAME THREE everywhere — no derivation, no per-file drift:
#
#   NETPLAN_IP_XA=198.51.100.10     # vm-xa        (manager template VM)
#   NETPLAN_IP_XB=198.51.100.11     # vm-xb        (queue + orchestrator)
#   NETPLAN_IP_3=198.51.100.13      # vm-hindsight (Hindsight)
#
# THE RULE (this is where juniors get bitten): the IP for a given VM must be
# identical in all three places —
#   1. the VM's netplan config (/etc/netplan/01-netcfg.yaml, M0 install doc §1),
#   2. this hosts.env (NETPLAN_IP_* — the M0 gate checks against these),
#   3. whatever resolves names for you: PVE DNS records, or the /etc/hosts
#      lines on all three VMs (M0 install doc §5; record the choice in
#      deploy/m0/decision-log.md).
# If they disagree, the M0 network matrix (§5) fails in confusing ways and
# later milestones (M1 cross-VM AMQP, M5 gateway) fail silently. One source of
# truth, three mirrors, zero drift.

# --- optional (defaults shown) ---------------------------------------------
# VMIDs if qm-creating fresh VMs on the PVE host
VMID_XA=900
VMID_XB=901
VMID_3=903
# Temporal cluster address the Go SDK smoke + CLI point at
#TEMPORAL_ADDR=vm-xb:7233
# Where to run the Go SDK smoke test (build host 'local' or any VM alias)
#SMOKE_HOST=local
# M5: engineer-reachable form of the gateway (default: http://$VM_XA:8080)
#GATEWAY_URL=http://vm-xa:8080
