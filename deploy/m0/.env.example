# M0 secret template — copy to the per-service .env next to each compose file
# (deploy/m0/rabbitmq/.env, deploy/m0/temporal/.env); .env files are GITIGNORED.
# Generate each value with:  openssl rand -hex 16
# deploy/m0/install.sh generates them automatically on first run.
RABBITMQ_PASS=            # RabbitMQ default user password (user: poc) — M0 §3
TEMPORAL_DB_PASS=         # Temporal's own Postgres password — M0 §4
